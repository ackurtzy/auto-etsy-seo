{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-etsy-seo.local/schemas/simulation-scenario-v1.schema.json",
  "title": "SimulationScenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "repetitions", "alpha", "practicalEffect", "planningEffect", "seed", "features", "listingCounts", "baselineTotals", "controlOutcomes", "treatmentOutcomes", "evaluatePower"],
  "properties": {
    "schemaVersion": {"const": "simulation-scenario-v1"},
    "scenarioId": {"type": "string", "minLength": 1},
    "repetitions": {"type": "integer", "minimum": 2000},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "practicalEffect": {"type": "number", "minimum": 0},
    "planningEffect": {"type": "number", "exclusiveMinimum": 0},
    "seed": {"type": "string", "minLength": 1},
    "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "listingCounts": {"type": "array", "minItems": 8, "items": {"type": "integer", "minimum": 1}},
    "baselineTotals": {"type": "array", "minItems": 8, "items": {"type": "number", "minimum": 0}},
    "controlOutcomes": {"type": "array", "minItems": 8, "items": {"type": "number", "minimum": 0}},
    "treatmentOutcomes": {"type": "array", "minItems": 8, "items": {"type": "number", "minimum": 0}},
    "evaluatePower": {"type": "boolean"}
  }
}
