{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-etsy-seo.local/schemas/experiment-spec-v1.schema.json",
  "title": "Frozen ExperimentSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hypothesis", "evidenceTier", "clusterRoster", "candidateHashes", "controlPolicy", "primaryMetric", "methodProfileId", "practicalEffect", "planningEffect", "baselineWindow", "measurementWindow", "allocationSeed", "assignment", "alpha", "errorBudgetFamily", "guardrails", "contaminationRules", "deploymentDeadline", "authorityCaps", "permittedConclusions", "maturityWaitHours", "evidenceRequirements", "estimatorVersion", "inferenceVersion", "specHash"],
  "properties": {
    "schemaVersion": {"const": "experiment-spec-v1"},
    "hypothesis": {"type": "string", "minLength": 1},
    "evidenceTier": {"const": "randomized_policy"},
    "clusterRoster": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["clusterId", "listingIds"], "properties": {"clusterId": {"type": "string", "minLength": 1}, "listingIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "candidateHashes": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "controlPolicy": {"const": "unchanged"},
    "primaryMetric": {"type": "string", "minLength": 1},
    "methodProfileId": {"const": "balanced-cluster-v1"},
    "practicalEffect": {"type": "number", "minimum": 0},
    "planningEffect": {"type": "number", "exclusiveMinimum": 0},
    "baselineWindow": {"$ref": "#/$defs/window"},
    "measurementWindow": {"$ref": "#/$defs/window"},
    "allocationSeed": {"type": "string", "minLength": 1},
    "assignment": {"type": "object", "minProperties": 2, "additionalProperties": {"enum": ["treatment", "control"]}},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "errorBudgetFamily": {"type": "string", "minLength": 1},
    "guardrails": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contaminationRules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "deploymentDeadline": {"type": "string", "format": "date-time"},
    "authorityCaps": {"type": "object", "additionalProperties": false, "required": ["mode", "expiresAt"], "properties": {"mode": {"const": "human_review_only"}, "expiresAt": {"type": "string", "format": "date-time"}}},
    "permittedConclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["evidence_of_change", "inconclusive", "invalid_data", "protocol_deviation", "safety_stopped"]}},
    "maturityWaitHours": {"type": "number", "minimum": 0},
    "evidenceRequirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "estimatorVersion": {"const": "listing-weighted-adjusted-v1"},
    "inferenceVersion": {"const": "balanced-sharp-null-v1"},
    "specHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {"window": {"type": "object", "additionalProperties": false, "required": ["start", "end", "exposureDays"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "exposureDays": {"type": "number", "exclusiveMinimum": 0}}}}
}
