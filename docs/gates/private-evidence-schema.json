{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private owner gate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate_id", "status", "approved_scope", "owner_approver", "approved_at", "expires_at", "evidence"],
  "properties": {
    "gate_id": {"type": "string", "pattern": "^G[0-7]"},
    "status": {"enum": ["failed", "passed", "passed_with_explicitly_disabled_capabilities"]},
    "approved_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "shop_id", "listing_ids", "capabilities"],
      "properties": {
        "environment": {"enum": ["read-only-validation", "live-canary"]},
        "shop_id": {"type": "string", "minLength": 1},
        "listing_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "owner_approver": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
